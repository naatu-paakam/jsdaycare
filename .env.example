# Copy this file to .env and fill in your values
# Never commit .env to git

# Supabase — get these from your Supabase project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used client-side for PortalAdmin cross-school queries
# On Netlify this is also set as SUPABASE_SERVICE_KEY (server-only, no VITE_ prefix)
# for the register-user serverless function
VITE_SUPABASE_SERVICE_KEY=your-service-role-key-here
